# Local development settings. Export them in your shell (for example `set -a; . ./.env; set +a`), then `npm run dev`.
DATABASE_URL=postgres://balilens:devpass@127.0.0.1:5432/balilens
PORT=3000
# Optional in development (an ephemeral random value is used if unset); required in production.
JWT_SECRET=
PSP_WEBHOOK_SECRET=
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
SEED_DEMO=true
DEMO_VENDOR_PASSWORD=
