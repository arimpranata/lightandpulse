# Copy to .env (never commit it) and fill in every value.
# Generate secrets with: openssl rand -hex 32

# Domain whose DNS A/AAAA record points at this VPS. Caddy gets the HTTPS certificate.
DOMAIN=balilens.example.com

POSTGRES_DB=balilens
POSTGRES_USER=balilens
# Use letters and digits only (it is placed in a connection URL).
POSTGRES_PASSWORD=

# At least 32 characters each.
JWT_SECRET=
PSP_WEBHOOK_SECRET=

# First admin account, created on first start if it does not exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Demo marketplace (records flagged demo, spec §41). Set to false for a launch
# with real vendors only. DEMO_VENDOR_PASSWORD, if set, creates the sign-in
# demo-vendor@balilens.local for the demo batik studio.
SEED_DEMO=true
DEMO_VENDOR_PASSWORD=
