# Bali Guide API — works on Hostinger (LiteSpeed) and Apache.
Options -Indexes

# Never serve PHP source or config files directly.
<FilesMatch "^(config(\.example)?|bootstrap|repository)\.php$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Send every request that isn't an existing file to the front controller.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>
